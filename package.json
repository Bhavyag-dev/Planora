{
  "name": "campus-events",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "dev:server": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend",
    "preview": "npm run preview --workspace frontend",
    "seed": "npm run seed --workspace backend",
    "seed:demo": "npm run seed:demo --workspace backend",
    "lint": "npm run lint --workspace frontend && npm run lint --workspace backend",
    "start": "npm run start --workspace backend"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.11",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "motion": "^13.1.0",
    "three": "^0.185.1"
  },
  "allowScripts": {
    "esbuild@0.27.4": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
